<doc>
Experimental explicit L2 capture conversions; no inferred mode or operational state.
</doc>
<template>
@record
interface {{ interface | regex="Ethernet[0-9]+/[0-9]+" }}
  description {{ description | phrase }}
  switchport mode {{ switchport_mode }}
  switchport access vlan {{ access_vlan | to_int }}
  switchport trunk allowed vlan {{ trunk_vlans | split(",") | expand_ranges("-") | map_int }}
@end
</template>
